// https://yalter.github.io/niri/Configuration:-Input
input {
    touchpad {
        tap
        natural-scroll
    }

    trackpoint {
        accel-speed 0.2
        accel-profile "flat"
    }
}

// External displays share the global layout; keep hardware-specific settings here.
output "ASUSTek COMPUTER INC XG32UCWMG T7LMQS028558" {
    mode "3840x2160@120.000"
    backdrop-color "#000000"
    scale 1
    layout {
        gaps 20
    }
}

output "LG Electronics LG HDR 4K 0x0003CF4A" {
    scale 1
}

// Office display.
output "LG Electronics LG ULTRAGEAR+ 308NTSUF9550" {
    scale 1
}

// meanovo display.
output "Samsung Display Corp. ATNA40HQ10-0  0x0000003F" {
    position x=3845 y=700
    backdrop-color "#000000"
    mode "2880x1800@120.000"
    layout {
        default-column-width { proportion 0.7; }
        struts {}
    }
}

cursor {
    // Hide the cursor after one second of inactivity.
    hide-after-inactive-ms 1000
    xcursor-theme "Adwaita"
}

environment {
	QT_QPA_PLATFORM "wayland;xcb"
	QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
	QT_AUTO_SCREEN_SCALE_FACTOR "1"
	QT_SCALE_FACTOR "1.1"
}

layout {
    background-color "#000000"
    always-center-single-column
    // Shared external-display layout; the laptop overrides width and struts.
    default-column-width { proportion 0.4; }
    struts {
        left 16
        right 16
        top 24
        bottom 24
    }
    focus-ring {
        width 1
        active-color "#b16286"
    }
}

spawn-sh-at-startup "quickshell -c workstation > /tmp/quickshell-startup.log 2>&1"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Teams screen-sharing preview: cover its initial, active, and inactive titles.
window-rule {
    match title="^Teams for Linux - (Screen Share Preview|Screen is being shared|Nothing is being shared)$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// Polkit prompts are independent toplevel windows, not tiled applications.
window-rule {
    match title="^Authentication Required$"
    open-floating true
    open-focused true
}

// Blur applications under the launcher, rather than showing only wallpaper.
// Keep this scoped: non-xray blur is more expensive than the default xray blur.
layer-rule {
    match namespace="^quickshell-launcher$"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
	match app-id="signal"
	default-column-width { fixed 600; }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Open a Terminal" { spawn "foot"; }
    Mod+D repeat=false hotkey-overlay-title="Open Applications" { spawn "qs" "-c" "workstation" "ipc" "call" "launcher" "toggle"; }
    Super+Alt+L repeat=false allow-when-locked=true allow-inhibiting=false hotkey-overlay-title="Lock the Screen" { spawn "workstation-lock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "volumeUp"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "volumeDown"; }
    XF86AudioMute        allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "volumeMute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "micMute"; }

    XF86AudioPlay        allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "mediaPlayPause"; }
    XF86AudioStop        allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "mediaStop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "mediaPrevious"; }
    XF86AudioNext        allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "mediaNext"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "brightnessUp"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "-c" "workstation" "ipc" "call" "osd" "brightnessDown"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+C { center-column; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Escape hatch for applications that inhibit compositor shortcuts.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }

    Mod+Shift+P { power-off-monitors; }
}
